# Copy this file to .env and fill in real values before running the server.
# Never commit .env — it holds secrets that must stay private.

PORT=5000

# development | production — controls cookie "secure" flag
NODE_ENV=development

# Leave as placeholder to use in-memory MongoDB during local dev (no Atlas required).
# For persistent data, replace with your Atlas URI:
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/devconnect
MONGO_URI=your_mongodb_atlas_connection_string

# Secret used to sign JWTs — use a long, random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend origin allowed by CORS (must match your Vite dev URL)
CLIENT_URL=http://localhost:5173

# Cloudinary — used for avatar uploads (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
